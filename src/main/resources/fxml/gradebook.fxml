<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gradebook.controller.GradebookController">
   <children>
      <!-- Top Action Bar & Summary Header -->
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <VBox spacing="2.0">
               <children>
                  <Label style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #0f172a;" text="Student Summary Report" />
                  <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="Comprehensive overview of all student grades, totals, and final performance." />
                  <Label style="-fx-font-size: 12px; -fx-text-fill: #2563eb; -fx-font-weight: 600;" text="Double-click any mark cell to edit directly." />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtSearch" prefWidth="260.0" promptText="🔍 Search by name or roll no..." styleClass="text-field-custom" />
         </children>
      </HBox>

      <!-- KPI Summary Cards (4 Cards with Icons) -->
      <HBox spacing="12.0">
         <children>
            <!-- 1. Enrolled Students Card -->
            <VBox prefWidth="200.0" styleClass="kpi-card" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="kpi-label" text="👥 TOTAL ENROLLED" />
                  <Label fx:id="lblTotalEnrolled" styleClass="kpi-value" text="0" />
               </children>
            </VBox>
            
            <!-- 2. Class Average Card -->
            <VBox prefWidth="200.0" styleClass="kpi-card" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="kpi-label" text="📊 CLASS AVERAGE (%)" />
                  <Label fx:id="lblClassAverage" styleClass="kpi-value-accent" text="0.0%" />
               </children>
            </VBox>

            <!-- 3. Highest Score Card -->
            <VBox prefWidth="240.0" styleClass="kpi-card" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="kpi-label" text="🏆 HIGHEST SCORE" />
                  <Label fx:id="lblHighestScore" styleClass="kpi-value-success" text="N/A" />
                  <Label fx:id="lblHighestStudent" styleClass="kpi-subtext" text="No student data" />
               </children>
            </VBox>

            <!-- 4. Lowest Score Card -->
            <VBox prefWidth="240.0" styleClass="kpi-card" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="kpi-label" text="🚩 LOWEST SCORE" />
                  <Label fx:id="lblLowestScore" styleClass="kpi-value-danger" text="N/A" />
                  <Label fx:id="lblLowestStudent" styleClass="kpi-subtext" text="No student data" />
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- Spreadsheet Gradebook Matrix -->
      <TableView fx:id="gradebookTable" editable="true" VBox.vgrow="ALWAYS">
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
