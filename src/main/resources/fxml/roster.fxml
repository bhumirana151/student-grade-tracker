<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gradebook.controller.RosterController">
   <children>
      <!-- Header -->
      <VBox spacing="2.0">
         <children>
            <Label style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #0f172a;" text="Manage Student Roster" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="Add or remove enrolled students. New students will automatically appear in the Gradebook Matrix." />
         </children>
      </VBox>

      <!-- Add Student Form Card -->
      <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #ffffff; -fx-padding: 16; -fx-background-radius: 6; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-border-width: 1px;">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label style="-fx-font-size: 11px; -fx-text-fill: #334155; -fx-font-weight: bold;" text="ROLL NUMBER" />
                  <TextField fx:id="txtRollNo" prefWidth="180.0" promptText="e.g. CS-2024-06" styleClass="text-field-custom" />
               </children>
            </VBox>
            
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label style="-fx-font-size: 11px; -fx-text-fill: #334155; -fx-font-weight: bold;" text="FULL NAME" />
                  <TextField fx:id="txtName" promptText="e.g. Devendra Singh" styleClass="text-field-custom" />
               </children>
            </VBox>

            <VBox alignment="BOTTOM_LEFT">
               <children>
                  <Button mnemonicParsing="false" onAction="#handleAddStudent" styleClass="btn-primary" text="➕ Add Student" />
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- Roster TableView -->
      <VBox spacing="10.0" VBox.vgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label fx:id="lblRosterCount" style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #0f172a;" text="Enrolled Students List" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#handleDeleteStudent" styleClass="btn-danger" text="🗑️ Delete Selected" />
               </children>
            </HBox>
            
            <TableView fx:id="rosterTable" VBox.vgrow="ALWAYS">
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <columns>
                  <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
                  <TableColumn fx:id="colRollNo" prefWidth="200.0" text="Roll Number" />
                  <TableColumn fx:id="colName" prefWidth="350.0" text="Student Full Name" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
